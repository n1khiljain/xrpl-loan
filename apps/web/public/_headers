# Cloudflare Pages, Cloudflare Workers static assets, and Netlify read this file. Other hosts need the same headers.
#
# Every page: a Content-Security-Policy.
# - frame-ancestors 'none': no other site can frame a button.
# - connect-src: Supabase (edge functions and receipt uploads) and what Privy needs for sign-in. The browser never
#   talks to the XRP Ledger: the edge functions submit every transaction.
# - script-src needs 'unsafe-inline': a static export inlines Next's bootstrap scripts and can't carry a nonce.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://*.supabase.co https://auth.privy.io https://*.privy.io; frame-src https://auth.privy.io https://challenges.cloudflare.com; child-src https://auth.privy.io; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
