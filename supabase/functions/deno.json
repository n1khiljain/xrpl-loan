{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@app/adapters": "../../packages/adapters/index.ts",
    "@app/config": "../../packages/config/src/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.117.1",
    "jose": "npm:jose@^6.2.12",
    "xrpl": "npm:xrpl@5.3.0",
    "zod": "npm:zod@^4.6.5"
  },
  "tasks": {
    "test": "deno test --allow-all",
    "check": "deno check **/*.ts"
  },
  "fmt": { "lineWidth": 120 },
  "lint": { "rules": { "exclude": ["no-explicit-any"] } }
}
