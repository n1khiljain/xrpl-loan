{
  "name": "xrpl-receivables",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "ts:test": "pnpm --filter @app/config test && pnpm --filter @app/adapters test",
    "db:test": "supabase test db",
    "functions:test": "cd supabase/functions && deno test --allow-all",
    "demo": "deno run --allow-all --config supabase/functions/deno.json scripts/local-demo.ts",
    "local": "bash scripts/local-up.sh"
  }
}
