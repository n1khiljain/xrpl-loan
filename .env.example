# Copy to .env and fill in locally. Never commit real values.
# Edge functions read only the names in supabase/functions/_shared/env.ts; a test keeps this file in sync.
# XRPL test networks only: the network config refuses mainnet.

# functions and scripts: picks deployments/<NETWORK>.json
NETWORK=xrpl-devnet

# web
NEXT_PUBLIC_NETWORK=xrpl-devnet
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# only used to call functions; every table denies it
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" in local builds to offer one-click demo people on the sign-in screen
NEXT_PUBLIC_DEMO_SESSIONS=

# edge functions (Supabase secrets in hosted environments)
# Supabase sets SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY inside functions; set them only to run functions elsewhere
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIVY_APP_ID=
# SPKI PEM from the Privy dashboard; \n escapes are fine. Also turn on "Return user data in an identity token".
PRIVY_VERIFICATION_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts every custodial wallet seed; losing it loses the wallets.
WALLET_ENCRYPTION_KEY=
# empty RESEND_API_KEY logs email subjects instead of sending
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000
