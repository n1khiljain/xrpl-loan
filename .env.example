# Copy to .env and fill in locally. Never commit real values.
# Edge functions read only the names in supabase/functions/_shared/env.ts; a test keeps this file in sync.

# contracts and functions: picks deployments/<NETWORK>.json
NETWORK=local

# web
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# only used to call functions; every table denies it
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# edge functions (Supabase secrets in hosted environments)
# Supabase sets SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY inside functions; set them only to run functions elsewhere
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# overrides the network config's rpcUrl; locally served functions run in Docker, so use http://host.docker.internal:8545
RPC_URL=
PRIVY_APP_ID=
# SPKI PEM from the Privy dashboard; \n escapes are fine
PRIVY_VERIFICATION_KEY=
# gas-drip on networks where adapters.gasSponsor is "drip"; a small hot wallet only
DRIP_PRIVATE_KEY=
DRIP_AMOUNT_WEI=
DRIP_THRESHOLD_WEI=
# simulate-payout on testnets; needs only gas (U-54)
PAYOUT_PRIVATE_KEY=
# FraxNet app credentials from Frax, for Connect FraxNet where adapters.fraxnet is "real" (U-77). Set the secret
# with `supabase secrets set`, never in a committed file
FRAXNET_CLIENT_ID=
FRAXNET_CLIENT_SECRET=
# empty until Frax shares it (U-51)
FRAXNET_WEBHOOK_SECRET=
# empty RESEND_API_KEY logs email subjects instead of sending
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000
# bearer pg_cron sends to chain-sync; also store it in Vault as chain_sync_secret
CHAIN_SYNC_SECRET=
